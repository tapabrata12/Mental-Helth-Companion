MONGODB_URL=# Paste you Connection String
PREFIX=/api
DATABASE_NAME=mindbridge
USER_COLLECTION=patient
ASSESSMENT_COLLECTION_NAME=assessments
CHROMA_COLLECTION_NAME=mindbridge_knowledge
CHROMA_DIR=vector_db
JWT_SECRET=# Paste your secret key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
KNOWLEDGE_DIR=rag_documents
#EMBEDDING_PROVIDER=ollama
EMBEDDING_PROVIDER=huggingface
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMINI_API_KEY=# Paste your API key here
GEMINI_MODEL=gemini-3.5-flash-lite
NVIDIA_API_KEY=# Paste your API key
NVIDIA_CHAT_MODEL=deepseek-ai/deepseek-v4-flash-0731
# In future it may depriciate
HUGGING_FACE_API_KEY= # Paste your key
HUGGING_FACE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B